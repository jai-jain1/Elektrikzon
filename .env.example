# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git and must never be committed.

# From sanity.io/manage -> your project -> Project ID (lowercase letters and digits)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Fixed API date so query behaviour never changes underneath the site
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# A long random string. Use the same value in the Sanity webhook "Secret" field.
SANITY_REVALIDATE_SECRET=change-me-to-a-long-random-string

# Public site URL, used for metadata, sitemap and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
